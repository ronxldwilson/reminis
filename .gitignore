# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
wheels/
*.whl

# Virtual environments
.venv/

# SQLite databases (generated)
*.db
*.db-shm
*.db-wal

# Model files (large, user-provided)
*.gguf
*.safetensors

# Generated viewers
*.html
# ...but the viewer's template is source, not output. Without this the file
# is invisible to git and to hatchling, which builds from the same list, so
# `reminis view` would fail on every installed copy while working locally.
!src/reminis/viewer_template.html

# Test model working directory
models/

# Test scratch directories
tests/tmp_*/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Benchmark corpora, downloaded on demand. The URL lives in issue #14; the
# repo does not carry the data, for the same reason it does not carry models.
eval-data/

# Benchmark result snapshots. Machine- and cache-specific, and regenerated
# by `python bench.py --json <file>`; the numbers that matter live in
# CHANGELOG.md.
bench_*.json

# Multi-domain experiment: weights, databases, and delta packs. All of it is
# rebuilt by the scripts in experiments/multidomain/ from a downloaded base
# model, so the repo carries the scripts, the training data, and the results
# and none of the ~21 GB they produce.
experiments/multidomain/base_model/
experiments/multidomain/fused_models/
experiments/multidomain/reminis_dbs/
experiments/multidomain/logs/
*_delta.bin
